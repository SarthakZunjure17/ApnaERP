# ApnaERP Production Environment Variables Example
PROJECT_NAME=ApnaERP
VERSION=1.3.0
ENVIRONMENT=production

# Database Settings
POSTGRES_USER=apnaerp_prod
POSTGRES_PASSWORD=super_secret_production_password_change_me
POSTGRES_DB=apnaerp_production
DATABASE_URL=postgresql+asyncpg://apnaerp_prod:super_secret_production_password_change_me@db:5432/apnaerp_production

# Redis Cache & Celery Broker Settings
REDIS_URL=redis://redis:6379/0

# Security Settings
SECRET_KEY=generate_a_secure_256bit_random_secret_key_here
JWT_SECRET_KEY=generate_a_secure_jwt_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Provider Settings
STORAGE_PROVIDER=Local
STORAGE_BASE_DIR=/var/apnaerp/uploads
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=sendgrid_secret_key
